{
  "name": "xxx-GitHubCopilotCostOptimization",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "workspaceFolder": "/workspace/xxx-GitHubCopilotCostOptimization/Student/Resources",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "hostRequirements": {
    "cpus": 2
  },
  "features": {},
  "customizations": {
    "vscode": {
      "extensions": [
        "github.copilot",
        "github.copilot-chat",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    },
    "codespaces": {
      "openFiles": [
        "xxx-GitHubCopilotCostOptimization/Student/Resources/README.md"
      ]
    }
  },
  "postCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && ~/.local/bin/uv tool install specify-cli --from git+https://github.com/github/spec-kit.git",

  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "CityScout NYC App",
      "onAutoForward": "notify"
    }
  }
}
